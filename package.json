{
  "name": "telegram-shasei-bot",
  "version": "0.1.0",
  "scripts": {
    "deploy": "wrangler deploy",
    "token": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "db:create": "wrangler d1 create telegram_shasei_bot",
    "db:init": "wrangler d1 execute telegram_shasei_bot --file=./schema.sql --remote",
    "dev": "wrangler dev",
    "test": "node scripts/generate-assets.mjs && vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/timespan-parser": "^1.2.3",
    "@types/vhtml": "^2.2.9",
    "typescript": "^7.0.2",
    "vitest": "^5",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "@codebam/cf-workers-telegram-bot": "^9.1.3",
    "telegramify-markdown": "^1.3.2",
    "timespan-parser": "^1.2.0"
  },
  "overrides": {
    "is-core-module": "npm:@nolyfill/is-core-module@^1"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
